# ============================================================================
# TalentOS Environment Configuration
# ============================================================================
# Copy this file to .env and replace the placeholders with your local values.
# Never commit .env to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# Backend (Express API server)
# ---------------------------------------------------------------------------
PORT=5000

DATABASE_URL=postgresql://username:password@localhost:5432/talentos

CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

LOG_LEVEL=info

# Comma-separated list of allowed frontend origins for CORS.
# Leave unset in development to allow localhost:5173 and localhost:5174.
# In production, set explicitly to your deployed frontend origin(s).
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# TalentOS frontend (Vite dev server)
# ---------------------------------------------------------------------------
VITE_PORT=5173

BASE_PATH=/

# Vite-exposed variables (must be prefixed with VITE_ to be available in the browser)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
VITE_CLERK_PROXY_URL=
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# Mockup sandbox (Vite dev server)
# ---------------------------------------------------------------------------
MOCKUP_PORT=5174

# ---------------------------------------------------------------------------
# AI evaluation (optional)
# ---------------------------------------------------------------------------
# Required only if you want to use the candidate-to-job AI evaluation feature.
# Choose one provider configuration block.

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (planned)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
